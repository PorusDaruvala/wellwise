{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellwise.example/schema/tip-pack.schema.json",
  "title": "Wellwise tip pack",
  "description": "A batch of new tips and links. scripts/build.py fills in every optional field and runs extra checks (unique ids, known trigger keys, links to real tips).",
  "type": "object",
  "required": ["tips"],
  "properties": {
    "pack": {"type": "string", "description": "A short name for this batch."},
    "tips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "category", "action", "why", "caution", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^ww-[0-9]{3,}$", "description": "Optional. The build picks the next free id."},
          "title": {"type": "string", "minLength": 3, "maxLength": 90, "description": "Start with a verb."},
          "category": {"type": "string", "enum": ["Food & nutrition", "Movement & mobility", "Sleep & recovery", "Household & cookware", "Skincare & personal care", "Supplements & medication", "Prevention & tests", "Mental wellbeing", "Air, water & environment", "Everyday health"]},
          "action": {"type": "string", "description": "One thing a person can do today."},
          "why": {"type": "string", "description": "One sentence, no stronger than the source."},
          "caution": {"type": "string", "description": "Who should take care, or when not to do it."},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}, "description": "The first source must back this exact tip."},
          "safety": {"type": "string", "enum": ["general", "check", "clinician"], "default": "general"},
          "grade": {"type": "string", "enum": ["Strong", "Moderate", "Limited", "Safety practice"]},
          "scope": {"type": "string", "enum": ["GLOBAL", "US", "IN", "GB", "OTHER"], "default": "GLOBAL"},
          "regions": {"type": "array", "items": {"type": "string", "enum": ["US", "IN", "GB", "OTHER"]}},
          "triggerKeys": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+:[a-z0-9_]+$"}},
          "notes": {"type": "object", "propertyNames": {"enum": ["US", "IN", "GB", "OTHER"]}, "additionalProperties": {"type": "string"}},
          "hi": {"type": "object", "properties": {"title": {"type": "string"}, "action": {"type": "string"}, "why": {"type": "string"}}},
          "status": {"type": "string", "enum": ["draft", "live", "retired"], "default": "live"},
          "timeline": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "sponsor": {"type": "object", "required": ["name", "criteria"], "properties": {"name": {"type": "string"}, "criteria": {"type": "string"}}}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["a", "b", "type", "why"],
        "properties": {
          "a": {"type": "string", "pattern": "^ww-[0-9]{3,}$"},
          "b": {"type": "string", "pattern": "^ww-[0-9]{3,}$"},
          "type": {"type": "string", "enum": ["complements", "reinforces", "shared-goal", "depends-on", "potential-conflict"]},
          "why": {"type": "string"}
        }
      }
    }
  }
}
