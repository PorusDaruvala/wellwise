# Copy to .env (or set these in your host's dashboard). Everything is optional except where noted.
PORT=8787
WELLWISE_PUBLIC_URL=https://wellwise.example.com      # used in links sent by WhatsApp and email
WELLWISE_DB=./data/wellwise.db
WELLWISE_ADMIN_TOKEN=change-me                         # required to use /admin

# Photos and documents (Claude). Without it, Wellwise reads barcodes, links and text only.
ANTHROPIC_API_KEY=
# WELLWISE_MODEL=claude-opus-5-5

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=+44 7700 900000
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE=                                      # approved template with 3 body parameters: title, action, link

# Inbound email (Postmark inbound webhook or compatible JSON)
WELLWISE_INBOUND_DOMAIN=
WELLWISE_INBOUND_SECRET=
